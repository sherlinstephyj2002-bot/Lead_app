rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Lead Attachments ────────────────────────────────────────
    // Path: leads/{companyId}/{leadId}/{timestamp}_{fileName}
    match /leads/{companyId}/{leadId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024  // 10 MB max
        && (request.resource.contentType.matches('image/.*')
           || request.resource.contentType.matches('application/pdf')
           || request.resource.contentType.matches('application/.*')
           || request.resource.contentType.matches('text/.*'));
    }

    // ─── Order Attachments ────────────────────────────────────────
    // Path: orders/{companyId}/{orderId}/{timestamp}_{fileName}
    match /orders/{companyId}/{orderId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024  // 10 MB max
        && (request.resource.contentType.matches('image/.*')
           || request.resource.contentType.matches('application/pdf')
           || request.resource.contentType.matches('application/.*')
           || request.resource.contentType.matches('text/.*'));
    }

    // ─── Profile Images ───────────────────────────────────────────
    // Path: profiles/{uid}/{fileName}
    match /profiles/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024   // 2 MB max for avatars
        && request.resource.contentType.matches('image/.*');
    }

    // ─── Employee Documents ─────────────────────────────────────────
    // Path: employee_documents/{companyId}/{employeeId}/{fileName}
    match /employee_documents/{companyId}/{employeeId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024  // 10 MB max
        && (request.resource.contentType.matches('image/.*')
           || request.resource.contentType.matches('application/pdf')
           || request.resource.contentType.matches('application/.*')
           || request.resource.contentType.matches('text/.*'));
    }

    // ─── Company Logos ─────────────────────────────────────────────
    // Path: company_logos/{companyId}/{fileName}
    match /company_logos/{companyId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 2 * 1024 * 1024   // 2 MB max for logo
        && request.resource.contentType.matches('image/.*');
    }

    // ─── Default deny ─────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
